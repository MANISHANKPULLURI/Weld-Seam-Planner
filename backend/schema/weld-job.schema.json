{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version 1.0.0"
    },
    "job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Job identifier job_YYYYMMDD_HHMM_xx"
        },
        "name": {
          "type": "string",
          "description": "Job name e.g. Stiffened panel rev B"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "ISO8601 UTC creation timestamp"
        },
        "tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "armatrix-weld-planner",
              "description": "Tool name"
            },
            "version": {
              "type": "string",
              "description": "Tool version 0.1.0"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "description": "Tool"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved"
          ],
          "description": "Job status draft or approved"
        },
        "notes": {
          "type": "string",
          "description": "Notes"
        },
        "execution": {
          "type": "object",
          "properties": {
            "arc_enabled": {
              "type": "boolean",
              "description": "Arc enabled flag"
            },
            "default_supervision": {
              "type": "string",
              "enum": [
                "operator_confirm",
                "auto"
              ],
              "description": "Default supervision mode"
            },
            "air_speed_mm_s": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Torch speed for moves between seams"
            },
            "waypoint_spacing_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Distance between exported waypoints along each seam"
            }
          },
          "required": [
            "arc_enabled",
            "default_supervision",
            "air_speed_mm_s",
            "waypoint_spacing_mm"
          ],
          "additionalProperties": false,
          "description": "Execution settings"
        }
      },
      "required": [
        "id",
        "name",
        "created_at",
        "tool",
        "status",
        "notes",
        "execution"
      ],
      "additionalProperties": false,
      "description": "Job metadata"
    },
    "frame": {
      "type": "object",
      "properties": {
        "units": {
          "type": "string",
          "const": "mm",
          "description": "All *_mm fields are millimetres in the job frame"
        },
        "handedness": {
          "type": "string",
          "const": "right",
          "description": "Coordinate handedness right-handed"
        },
        "up_axis": {
          "type": "string",
          "enum": [
            "+z",
            "+y"
          ],
          "description": "Up axis in job frame"
        },
        "gravity": {
          "type": "array",
          "items": [
            {
              "type": "number",
              "description": "Gravity X"
            },
            {
              "type": "number",
              "description": "Gravity Y"
            },
            {
              "type": "number",
              "description": "Gravity Z"
            }
          ],
          "additionalItems": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "Gravity vector in job frame"
        },
        "part_to_job": {
          "type": "object",
          "properties": {
            "scale_to_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Multiply part file coordinates by this to get millimetres (file units: mm 1, cm 10, m 1000, inch 25.4)"
            },
            "translation_mm": {
              "type": "array",
              "items": [
                {
                  "type": "number",
                  "description": "Translation X mm"
                },
                {
                  "type": "number",
                  "description": "Translation Y mm"
                },
                {
                  "type": "number",
                  "description": "Translation Z mm"
                }
              ],
              "additionalItems": false,
              "minItems": 3,
              "maxItems": 3,
              "description": "Translation from part to job frame in millimetres"
            },
            "rotation_quaternion_xyzw": {
              "type": "array",
              "items": [
                {
                  "type": "number",
                  "description": "Quaternion X"
                },
                {
                  "type": "number",
                  "description": "Quaternion Y"
                },
                {
                  "type": "number",
                  "description": "Quaternion Z"
                },
                {
                  "type": "number",
                  "description": "Quaternion W"
                }
              ],
              "additionalItems": false,
              "minItems": 4,
              "maxItems": 4,
              "description": "Rotation quaternion xyzw from part to job frame"
            }
          },
          "required": [
            "scale_to_mm",
            "translation_mm",
            "rotation_quaternion_xyzw"
          ],
          "additionalProperties": false,
          "description": "job = rotation · (scale_to_mm · part) + translation"
        }
      },
      "required": [
        "units",
        "handedness",
        "up_axis",
        "gravity",
        "part_to_job"
      ],
      "additionalProperties": false,
      "description": "Job frame"
    },
    "part": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "description": "Original STL filename"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "SHA256 hex of original file bytes, null if the browser could not hash"
        },
        "triangle_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Triangle count in original file"
        },
        "bbox_mm": {
          "type": "object",
          "properties": {
            "min": {
              "type": "array",
              "items": [
                {
                  "type": "number",
                  "description": "Min X mm"
                },
                {
                  "type": "number",
                  "description": "Min Y mm"
                },
                {
                  "type": "number",
                  "description": "Min Z mm"
                }
              ],
              "additionalItems": false,
              "minItems": 3,
              "maxItems": 3,
              "description": "Minimum corner of bounding box in millimetres"
            },
            "max": {
              "type": "array",
              "items": [
                {
                  "type": "number",
                  "description": "Max X mm"
                },
                {
                  "type": "number",
                  "description": "Max Y mm"
                },
                {
                  "type": "number",
                  "description": "Max Z mm"
                }
              ],
              "additionalItems": false,
              "minItems": 3,
              "maxItems": 3,
              "description": "Maximum corner of bounding box in millimetres"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "description": "Bounding box in job frame millimetres"
        },
        "repaired": {
          "type": "boolean",
          "description": "Whether mesh repair was applied"
        }
      },
      "required": [
        "filename",
        "sha256",
        "triangle_count",
        "bbox_mm",
        "repaired"
      ],
      "additionalProperties": false,
      "description": "Part"
    },
    "procedures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable procedure identifier"
          },
          "name": {
            "type": "string",
            "description": "EXAMPLE preset name, never recommendation"
          },
          "process": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "gmaw",
                    "description": "Gas metal arc welding"
                  },
                  "iso_4063": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 131,
                        "description": "MIG 131"
                      },
                      {
                        "type": "number",
                        "const": 135,
                        "description": "MAG 135"
                      }
                    ],
                    "description": "ISO 4063 process code"
                  }
                },
                "required": [
                  "kind",
                  "iso_4063"
                ],
                "additionalProperties": false,
                "description": "GMAW process"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "fcaw",
                    "description": "Flux cored arc welding"
                  },
                  "iso_4063": {
                    "type": "number",
                    "const": 136,
                    "description": "ISO 4063 136"
                  }
                },
                "required": [
                  "kind",
                  "iso_4063"
                ],
                "additionalProperties": false,
                "description": "FCAW process"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "gtaw",
                    "description": "Gas tungsten arc welding"
                  },
                  "iso_4063": {
                    "type": "number",
                    "const": 141,
                    "description": "ISO 4063 141"
                  }
                },
                "required": [
                  "kind",
                  "iso_4063"
                ],
                "additionalProperties": false,
                "description": "GTAW process"
              }
            ],
            "description": "Process kind and ISO code"
          },
          "material": {
            "description": "Base metal and thickness; older jobs may omit it",
            "type": "object",
            "properties": {
              "metal": {
                "type": "string",
                "enum": [
                  "steel",
                  "stainless",
                  "aluminium",
                  "other"
                ],
                "description": "Base metal the procedure is tuned for"
              },
              "thickness_mm": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Plate thickness in millimetres or null when unset"
              }
            },
            "required": [
              "metal",
              "thickness_mm"
            ],
            "additionalProperties": false
          },
          "wire": {
            "type": "object",
            "properties": {
              "diameter_mm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Wire diameter in millimetres"
              }
            },
            "required": [
              "diameter_mm"
            ],
            "additionalProperties": false,
            "description": "Wire"
          },
          "gas": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Gas name example mix"
              },
              "flow_l_min": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Gas flow litres per minute or null"
              }
            },
            "required": [
              "name",
              "flow_l_min"
            ],
            "additionalProperties": false,
            "description": "Gas"
          },
          "electrical": {
            "type": "object",
            "properties": {
              "voltage_v": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Arc voltage, volts"
              },
              "current_a": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Welding current, amps (needed for arc energy)"
              },
              "wire_feed_speed_m_min": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Wire feed speed metres per minute or null"
              }
            },
            "required": [
              "voltage_v",
              "current_a",
              "wire_feed_speed_m_min"
            ],
            "additionalProperties": false,
            "description": "Electrical parameters"
          },
          "motion": {
            "type": "object",
            "properties": {
              "travel_speed_mm_min": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Travel speed millimetres per minute"
              }
            },
            "required": [
              "travel_speed_mm_min"
            ],
            "additionalProperties": false,
            "description": "Motion"
          },
          "thermal_efficiency_k": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Thermal efficiency k 0.8 gmaw/fcaw 0.6 gtaw editable"
          },
          "limits": {
            "type": "object",
            "properties": {
              "heat_input_kj_mm": {
                "type": "object",
                "properties": {
                  "min": {
                    "description": "Minimum heat input or null",
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "max": {
                    "description": "Maximum heat input or null",
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false,
                "description": "Heat input limits"
              },
              "travel_speed_mm_min": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "min": {
                        "description": "Minimum travel speed or null",
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "max": {
                        "description": "Maximum travel speed or null",
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Travel speed limits or null"
              },
              "max_throat_per_pass_mm": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Largest throat one pass can lay; bigger welds need more passes. Null = no check"
              }
            },
            "required": [
              "heat_input_kj_mm",
              "travel_speed_mm_min",
              "max_throat_per_pass_mm"
            ],
            "additionalProperties": false,
            "description": "User-defined limits"
          },
          "seam_defaults": {
            "type": "object",
            "properties": {
              "weld_size": {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": [
                      "a",
                      "z"
                    ]
                  },
                  "value_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "basis",
                  "value_mm"
                ],
                "additionalProperties": false,
                "description": "Weld size given to seams this procedure is first applied to"
              },
              "travel_angle_deg": {
                "type": "number",
                "description": "Default travel angle, positive = push"
              },
              "stick_out_mm": {
                "type": "number",
                "minimum": 0,
                "description": "Default contact tip to work distance"
              }
            },
            "required": [
              "weld_size",
              "travel_angle_deg",
              "stick_out_mm"
            ],
            "additionalProperties": false,
            "description": "Defaults for seams when this procedure is first applied"
          }
        },
        "required": [
          "id",
          "name",
          "process",
          "wire",
          "gas",
          "electrical",
          "motion",
          "thermal_efficiency_k",
          "limits",
          "seam_defaults"
        ],
        "additionalProperties": false,
        "description": "Welding procedure"
      },
      "description": "Procedure library"
    },
    "access": {
      "type": "object",
      "properties": {
        "entry_ports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position_mm": {
                "type": "array",
                "items": [
                  {
                    "type": "number",
                    "description": "X"
                  },
                  {
                    "type": "number",
                    "description": "Y"
                  },
                  {
                    "type": "number",
                    "description": "Z"
                  }
                ],
                "additionalItems": false,
                "minItems": 3,
                "maxItems": 3,
                "description": "Port position millimetres"
              },
              "direction": {
                "type": "array",
                "items": [
                  {
                    "type": "number",
                    "description": "X"
                  },
                  {
                    "type": "number",
                    "description": "Y"
                  },
                  {
                    "type": "number",
                    "description": "Z"
                  }
                ],
                "additionalItems": false,
                "minItems": 3,
                "maxItems": 3,
                "description": "Port direction unit vector"
              },
              "diameter_mm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Port diameter millimetres"
              }
            },
            "required": [
              "position_mm",
              "direction",
              "diameter_mm"
            ],
            "additionalProperties": false,
            "description": "Entry port"
          },
          "description": "Entry ports"
        },
        "arm": {
          "type": "object",
          "properties": {
            "reach_mm": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Arm reach millimetres or null"
            },
            "tip_diameter_mm": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tip diameter millimetres or null"
            }
          },
          "required": [
            "reach_mm",
            "tip_diameter_mm"
          ],
          "additionalProperties": false,
          "description": "Arm"
        }
      },
      "required": [
        "entry_ports",
        "arm"
      ],
      "additionalProperties": false,
      "description": "Access plan optional"
    },
    "seams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable seam identifier never renumbered"
          },
          "name": {
            "type": "string",
            "description": "Seam display name"
          },
          "sequence": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Execution order 1-indexed must equal array position"
          },
          "operation": {
            "type": "string",
            "const": "weld",
            "description": "Operation weld extensible"
          },
          "joint": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "fillet",
                  "butt",
                  "corner",
                  "unknown"
                ],
                "description": "Joint type guess"
              },
              "dihedral_deg": {
                "type": "number",
                "minimum": 0,
                "maximum": 180,
                "description": "Dihedral angle degrees"
              },
              "concavity": {
                "type": "string",
                "enum": [
                  "concave",
                  "convex"
                ],
                "description": "Concavity"
              },
              "type_source": {
                "type": "string",
                "enum": [
                  "detected",
                  "user"
                ],
                "description": "Source of joint type"
              }
            },
            "required": [
              "type",
              "dihedral_deg",
              "concavity",
              "type_source"
            ],
            "additionalProperties": false,
            "description": "Joint"
          },
          "weld_position": {
            "type": "object",
            "properties": {
              "iso_6947": {
                "type": "string",
                "enum": [
                  "PA",
                  "PB",
                  "PC",
                  "PD",
                  "PE",
                  "PF",
                  "PG",
                  "inclined"
                ],
                "description": "ISO 6947 code derived"
              },
              "aws": {
                "type": "string",
                "enum": [
                  "1G",
                  "1F",
                  "2G",
                  "2F",
                  "3G",
                  "3F",
                  "4G",
                  "4F",
                  "inclined"
                ],
                "description": "AWS equivalent"
              },
              "source": {
                "type": "string",
                "enum": [
                  "derived",
                  "user"
                ],
                "description": "Source derived or user override"
              }
            },
            "required": [
              "iso_6947",
              "aws",
              "source"
            ],
            "additionalProperties": false,
            "description": "Weld position"
          },
          "direction": {
            "type": "string",
            "enum": [
              "forward",
              "backward"
            ],
            "description": "Seam direction"
          },
          "procedure_ref": {
            "type": "string",
            "description": "Reference to procedure id"
          },
          "overrides": {
            "type": "object",
            "properties": {
              "voltage_v": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "current_a": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "wire_feed_speed_m_min": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "travel_speed_mm_min": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false,
            "description": "Values that differ from the procedure for this seam only"
          },
          "effective": {
            "type": "object",
            "properties": {
              "voltage_v": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "current_a": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "wire_feed_speed_m_min": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "travel_speed_mm_min": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "voltage_v",
              "current_a",
              "wire_feed_speed_m_min",
              "travel_speed_mm_min"
            ],
            "additionalProperties": false,
            "description": "Values the robot should use: procedure plus overrides"
          },
          "torch": {
            "type": "object",
            "properties": {
              "work_angle_offset_deg": {
                "type": "number",
                "description": "Work angle offset degrees zero is bisector"
              },
              "travel_angle_deg": {
                "type": "number",
                "description": "Travel angle degrees positive is push"
              },
              "travel_angle_convention": {
                "type": "string",
                "const": "positive_push",
                "description": "Travel angle convention"
              },
              "stick_out_mm": {
                "type": "number",
                "minimum": 0,
                "description": "Stick out millimetres"
              }
            },
            "required": [
              "work_angle_offset_deg",
              "travel_angle_deg",
              "travel_angle_convention",
              "stick_out_mm"
            ],
            "additionalProperties": false,
            "description": "Torch settings"
          },
          "start": {
            "type": "object",
            "properties": {
              "approach_mm": {
                "type": "number",
                "minimum": 0,
                "description": "Approach distance millimetres"
              },
              "run_in_mm": {
                "type": "number",
                "minimum": 0,
                "description": "Run-in millimetres"
              }
            },
            "required": [
              "approach_mm",
              "run_in_mm"
            ],
            "additionalProperties": false,
            "description": "Start settings"
          },
          "end": {
